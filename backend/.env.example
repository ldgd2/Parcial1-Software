# ==========================================
# Configuración del Backend (Diagramador Real-Time API)
# ==========================================

# Clave secreta (Cámbiala en producción)
SECRET_KEY=supersecretkey_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# Base de Datos (PostgreSQL)
# ==========================================
DB_IP=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=diagramador

# ==========================================
# Configuración de Correo para OTP
# ==========================================
GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=tu_contraseña_de_aplicacion

# ==========================================
# Configuración de IA
# ==========================================
# Proveedor del servicio de IA (googlecloud o openroute)
IA_SERVICE=googlecloud

# API Key general (Para Gemini o OpenRouter)
IA_API=tu_api_key_aqui

# API Key para modelo de visión (Opcional, si usa otro proveedor para imágenes)
IA_IMAGE_API=tu_api_key_de_vision_aqui
