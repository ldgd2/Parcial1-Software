# ==========================================
# Configuración del Backend (Diagramador Real-Time API)
# ==========================================

# Clave secreta (Cámbiala en producción)
SECRET_KEY=supersecretkey_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# Base de Datos (PostgreSQL)
# ==========================================
DB_IP=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=diagramador

# ==========================================
# Configuración de Correo para OTP
# ==========================================
GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=tu_contraseña_de_aplicacion

# ==========================================
# Configuración de IA
# ==========================================
GEMINI_API=tu_api_key_de_gemini
OPENROUTE_API=tu_api_key_de_openrouter
IMAGE_OPEROUTE_API=tu_api_key_de_vision_si_aplica

# Modelo de IA (Para OpenRouter)
IA_MODEL=cohere/north-mini-code:free
GITHUB_CLIENT_ID=tu_github_client_id_aqui
GITHUB_CLIENT_SECRET=tu_github_client_secret_aqui
ENCRYPTION_MASTER_KEY=tu_encryption_master_key_aqui

# ==========================================
# Configuración del Hook del Deployer Externo
# ==========================================
DEPLOYER_URL=http://host.example.com/api/v1/deploy/webhook
HOST_DOMAIN=http://localhost