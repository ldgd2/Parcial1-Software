    "de", "del", "y", "en", "con", "por", "para", "un", "una", "el", "la", "los", "las", "al", "o"
}

NATURAL_LANGUAGE_WORDS = {
    "se", "es", "son", "del", "al", "este", "esta", "estos", "estas", "todo",
    "todos", "toda", "todas", "clases", "diagrama", "modelo",
