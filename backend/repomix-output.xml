    r2 = await cliente.post(f"/api/ia/contexto/{equipo.pid}/versiones/{r.json()['id']}/decision", json={"aceptar": True})
    assert r2.status_code == 400


async def test_la_ia_recibe_las_correcciones_abiertas(cliente, equipo, ia):
