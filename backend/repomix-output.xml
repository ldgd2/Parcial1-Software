            os.system("sudo rm -f /etc/systemd/system/backend-app.service /etc/systemd/system/frontend-app.service")
            os.system("sudo systemctl daemon-reload")
            
            console.print("[cyan]Eliminando configuraciones NGINX...[/cyan]")
